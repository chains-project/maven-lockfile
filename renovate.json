{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "helpers:pinGitHubActionDigests",
    "config:recommended"
  ],
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com",
    "github-actions[bot]@users.noreply.github.com"
  ],
  "digest": {
    "enabled": false
  },
  "semanticCommitType": ":arrow_up:",
  "semanticCommits": "enabled",
  "minimumReleaseAge": "1d",
  "automergeStrategy": "squash",
  "customManagers": [
    {
      "customType": "regex",
      "description": "palantir-java-format version pinned in the spotless configuration",
      "managerFilePatterns": [
        "/^pom\\.xml$/"
      ],
      "matchStrings": [
        "<palantirJavaFormat>\\s*<version>(?<currentValue>[^<]+)</version>"
      ],
      "depNameTemplate": "com.palantir.javaformat:palantir-java-format",
      "datasourceTemplate": "maven"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin"
      ],
      "automerge": true,
      "automergeType": "pr",
      "semanticCommitType": ":arrow_up:"
    },
    {
      "matchUpdateTypes": [
        "lockFileMaintenance",
        "pin"
      ],
      "semanticCommitType": ":pushpin:",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchUpdateTypes": [
        "rollback"
      ],
      "semanticCommitType": ":arrow_down:",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchUpdateTypes": [
        "bump"
      ],
      "semanticCommitType": ":bookmark:",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "enabled": false,
      "matchPackageNames": [
        "/org.apache.maven:/"
      ]
    },
    {
      "description": "Formatter bumps need a manual mvn spotless:apply before merging",
      "matchPackageNames": [
        "com.palantir.javaformat:palantir-java-format"
      ],
      "automerge": false
    }
  ]
}
